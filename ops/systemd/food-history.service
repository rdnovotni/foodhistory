[Unit]
Description=Food History public catalogue
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=foodhistory
Group=foodhistory
WorkingDirectory=/opt/foodhistory
ExecStart=/usr/bin/docker compose --env-file .env.production -f compose.production.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file .env.production -f compose.production.yaml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
