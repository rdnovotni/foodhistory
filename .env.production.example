# Copy to .env.production, replace every example value, then run chmod 600.
# Generate a URL-safe password with: openssl rand -hex 32
POSTGRES_USER=food_history
POSTGRES_PASSWORD=replace-with-64-hex-characters
POSTGRES_DB=food_history
# Separate login used only by the future public read process.
PUBLIC_DATABASE_USER=food_history_public
PUBLIC_DATABASE_PASSWORD=replace-with-a-different-64-hex-password
# Private Tailscale URL after `tailscale serve` is enabled. Localhost also works initially.
SITE_BASE_URL=http://127.0.0.1:8000
# Set false only for initial localhost testing. Keep true for Tailscale HTTPS.
EDITOR_COOKIE_SECURE=true
# Maximum accepted editorial image upload size (10 MiB).
MEDIA_MAX_BYTES=10485760
# Reserved for the later public launch. These do nothing until the public profile is enabled.
PUBLIC_HOST=history.example.com
ACME_EMAIL=admin@example.com
